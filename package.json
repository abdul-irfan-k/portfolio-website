    "@studio-freight/hamo": "^0.6.33",
    "@studio-freight/lenis": "^1.0.34",
    "@studio-freight/react-lenis": "^0.0.43",
    "framer-motion": "^12.43.0",
    "gsap": "^3.12.3",
    "locomotive-scroll": "^5.0.0-beta.11",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-responsive": "^9.0.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "postcss": "^8",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
